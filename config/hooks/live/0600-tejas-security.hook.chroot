#!/bin/sh
# TEJAS security defaults: firewall on (nothing can connect in), security updates
# install by themselves, and the live/installed system never has a blank root login.
set -e

# Firewall: block incoming connections, allow outgoing. Turned on at every boot.
# No firewall = stop the build, never ship an ISO without one.
[ -f /etc/ufw/ufw.conf ] || { echo "ufw is missing: refusing to continue" >&2; exit 1; }
sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/; s/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' /etc/default/ufw
systemctl enable ufw.service 2>/dev/null || true
# Nothing is opened for Tejas AI here. To let phones on the home Wi-Fi in, allow only that network:
#   sudo ufw allow from 192.168.1.0/24 to any port 8443 proto tcp
[ -x /usr/bin/unattended-upgrade ] || { echo "unattended-upgrades is missing: refusing to continue" >&2; exit 1; }

# Security updates install automatically every day.
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'CFG'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
CFG

# Lock the root account (the installer sets up a normal user with sudo).
passwd -l root >/dev/null 2>&1 || true
# ...and make the installer keep it locked on the installed PC, with no auto-login.
U=/etc/calamares/modules/users.conf
if [ -f "$U" ]; then
	sed -i -E '/^(setRootPassword|doReusePassword|doAutologin):/d' "$U"
	printf 'setRootPassword: false\ndoReusePassword: false\ndoAutologin: false\n' >> "$U"
fi

# Hide other users' home folders.
sed -i 's/^#\?DIR_MODE=.*/DIR_MODE=0700/' /etc/adduser.conf 2>/dev/null || true
grep -q '^HOME_MODE' /etc/login.defs && sed -i 's/^HOME_MODE.*/HOME_MODE\t0700/' /etc/login.defs || echo 'HOME_MODE	0700' >> /etc/login.defs
